# Copiar a .env (o configurar como variables de entorno / EnvironmentFile de systemd).
# NO subir el archivo .env real al repositorio.
APP_ENV=development            # development | production
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
DATABASE_PATH=instance/sgr.sqlite3

# Recuperación de contraseña (valores referenciales del PDF)
CODIGO_VIGENCIA_MIN=10
CODIGO_REENVIO_SEG=45
CODIGO_MAX_INTENTOS=5
CODIGO_MAX_SOLICITUDES_HORA=5

# Bloqueo por intentos fallidos de login
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15

# Correo: console (simulado, deja el código en la bandeja de desarrollo) | smtp
MAIL_MODE=console
MAIL_FROM=no-responder@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Bandeja de desarrollo (/dev/bandeja). Debe estar en 0 en producción real.
DEV_OUTBOX=1
SESSION_COOKIE_SECURE=0        # poner 1 cuando exista HTTPS
