[Unit]
Description=SGR - Gestion de Atencion Ciudadana (gunicorn)
After=network.target

[Service]
User=sgr
Group=sgr
WorkingDirectory=/opt/sgr
EnvironmentFile=/etc/sgr/sgr.env
ExecStart=/opt/sgr/.venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 --access-logfile - wsgi:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
